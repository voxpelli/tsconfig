{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node 26",

  "extends": "./base-node-jsdoc.json",

  "compilerOptions": {
    /* Based on https://github.com/tsconfig/bases/blob/12474cd696ec17c6ac4ccc19261860bf3c7fdc56/bases/node26.json */
    "lib": [
      "es2025",
      "ESNext.Collection",
      "ESNext.Temporal"
    ],
    "target": "es2025",

    /*
     * Setting a strict module resolution
     *
     * Currently "nodenext" is an alias for "node16", but that might change, so lets pin it
     *
     * Docs: https://www.typescriptlang.org/docs/handbook/modules/theory.html#module-resolution
     * Prior art: https://github.com/tsconfig/bases/blob/12474cd696ec17c6ac4ccc19261860bf3c7fdc56/bases/node26.json
     */
    "module": "nodenext",
    "moduleResolution": "node16"
  }
}
